{
  "components": {
    "schemas": {
      "ErrorResponse": {
        "description": "Uniform machine-readable API error shape.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventData": {
        "additionalProperties": false,
        "description": "Only metadata the timeline is allowed to expose from stored event JSON.",
        "properties": {
          "attempt_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt Id"
          },
          "cancelled_jobs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cancelled Jobs"
          },
          "capacity_resume_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Capacity Resume At"
          },
          "failure_class": {
            "anyOf": [
              {
                "enum": [
                  "invalid_input",
                  "missing_credential",
                  "transient_read",
                  "unsupported_environment",
                  "resource_exhaustion",
                  "model_response_lost",
                  "unknown_effect",
                  "remote_conflict",
                  "corrupt_artifact"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Class"
          },
          "failure_count": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Count"
          },
          "generation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generation"
          },
          "invalidated_attempts": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invalidated Attempts"
          },
          "job_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "next_job_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Job Id"
          },
          "replay_policy": {
            "anyOf": [
              {
                "enum": [
                  "replay_safe",
                  "attention_on_unknown"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Replay Policy"
          },
          "retry_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry At"
          },
          "retry_scheduled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Scheduled"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "step_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Step Id"
          },
          "target_run_status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunStatus"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "title": "EventData",
        "type": "object"
      },
      "EventPageResponse": {
        "additionalProperties": false,
        "properties": {
          "after_sequence": {
            "title": "After Sequence",
            "type": "string"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/TimelineEventResponse"
            },
            "title": "Events",
            "type": "array"
          },
          "high_watermark": {
            "title": "High Watermark",
            "type": "string"
          },
          "history_gap": {
            "title": "History Gap",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "after_sequence",
          "events",
          "next_cursor",
          "high_watermark",
          "history_gap"
        ],
        "title": "EventPageResponse",
        "type": "object"
      },
      "EventStreamErrorPayload": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "authentication_required",
              "event_stream_unavailable"
            ],
            "title": "Code",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "retryable"
        ],
        "title": "EventStreamErrorPayload",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Documented successful health response shape.",
        "properties": {
          "checks": {
            "anyOf": [
              {
                "additionalProperties": {
                  "const": "ok",
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checks"
          },
          "status": {
            "enum": [
              "ok",
              "ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HistoryResetPayload": {
        "additionalProperties": false,
        "properties": {
          "high_watermark": {
            "title": "High Watermark",
            "type": "string"
          },
          "reason": {
            "enum": [
              "cursor_ahead",
              "history_gap"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason",
          "high_watermark"
        ],
        "title": "HistoryResetPayload",
        "type": "object"
      },
      "RunSnapshotResponse": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "deadline_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline At"
          },
          "event_watermark": {
            "title": "Event Watermark",
            "type": "string"
          },
          "revision": {
            "title": "Revision",
            "type": "integer"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        },
        "required": [
          "run_id",
          "status",
          "revision",
          "created_at",
          "deadline_at",
          "event_watermark"
        ],
        "title": "RunSnapshotResponse",
        "type": "object"
      },
      "RunStatus": {
        "enum": [
          "queued",
          "running",
          "waiting_approval",
          "waiting_credentials",
          "waiting_capacity",
          "needs_attention",
          "succeeded",
          "failed",
          "cancelled",
          "expired"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "TimelineEventResponse": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/EventData"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "sequence": {
            "title": "Sequence",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "run_id",
          "sequence",
          "type",
          "occurred_at",
          "data"
        ],
        "title": "TimelineEventResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Continumm API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/runs/{run_id}": {
      "get": {
        "operationId": "get_run_snapshot_api_v1_runs__run_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Run Snapshot",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/v1/runs/{run_id}/events": {
      "get": {
        "operationId": "get_run_events_api_v1_runs__run_id__events_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Run Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "after",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "maxLength": 19,
              "title": "After"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "maxLength": 19,
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPageResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-event-payloads": {
                  "history.reset": {
                    "$ref": "#/components/schemas/HistoryResetPayload"
                  },
                  "run.event": {
                    "$ref": "#/components/schemas/TimelineEventResponse"
                  },
                  "stream.error": {
                    "$ref": "#/components/schemas/EventStreamErrorPayload"
                  }
                }
              }
            },
            "description": "JSON event page or replayable server-sent event stream."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get Run Events",
        "tags": [
          "runs"
        ]
      }
    },
    "/health/live": {
      "get": {
        "description": "Report that the process can serve requests.",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Report readiness without claiming an unimplemented database check.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
