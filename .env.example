CONTINUUM_ENVIRONMENT=development
CONTINUUM_HOST=127.0.0.1
CONTINUUM_PORT=8000
CONTINUUM_LOG_LEVEL=INFO
CONTINUUM_SUPABASE_BUCKET=continuum-t03-private
CONTINUUM_ENABLE_HOSTED_SMOKE=0
CONTINUUM_ENABLE_SANDBOX_SMOKE=0
CONTINUUM_SANDBOX_IMAGE=
CONTINUUM_T04_SMOKE_ID=

# Server-only values; do not commit populated credentials.
# AES-256 key: canonical URL-safe base64 encoding of 32 random bytes, supplied through secrets.
# CONTINUUM_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# CONTINUUM_ENCRYPTION_KEY_VERSION=v1
# Keep old versions only while active ciphertext still requires them; values are secrets.
# CONTINUUM_ENCRYPTION_PREVIOUS_KEYS={"v0":"<previous-base64-key>"}
# CONTINUUM_DATABASE_URL=postgresql://...
# The run API uses only the least-privilege continuum_runtime login.
# Local development may disable TLS only for a loopback database; remote URLs use verified TLS.
# CONTINUUM_RUNTIME_DATABASE_URL=postgresql://continuum_runtime:<password>@127.0.0.1:5432/continumm?sslmode=disable
# Production uses verify-full and system CA roots; see PostgreSQL 17 libpq SSL settings.
# CONTINUUM_RUNTIME_DATABASE_URL=postgresql://continuum_runtime:<password>@<host>/<database>?sslmode=verify-full&sslrootcert=system
# Optional T42 operations view/CLI use a separate operator login and immutable GitHub user ID allowlist.
# CONTINUUM_OPERATOR_DATABASE_URL=postgresql://continuum_operator:<password>@<host>/<database>?sslmode=verify-full&sslrootcert=system
# CONTINUUM_OPERATOR_GITHUB_USER_IDS=12345,67890
# CONTINUUM_SUPABASE_URL=https://<project-ref>.supabase.co
# CONTINUUM_SUPABASE_SECRET_KEY=sb_secret_...
# CONTINUUM_SANDBOX_IMAGE=vercel/sandbox/python:3.14@sha256:<operator-supplied-digest>
# CONTINUUM_T04_SMOKE_ID=<fresh-canonical-uuid-used-once>
# CONTINUUM_VERCEL_TOKEN=...
# CONTINUUM_VERCEL_TEAM_ID=...
# CONTINUUM_VERCEL_PROJECT_ID=...

# T05 ingress is configured only in Supabase Function secrets; never expose these to the browser.
# CONTINUUM_GITHUB_APP_ID=<positive-decimal-github-app-id>
# CONTINUUM_GITHUB_WEBHOOK_SECRET=<high-entropy-github-app-webhook-secret>
# CONTINUUM_INGRESS_DATABASE_URL=<TLS URL copied from Supabase Connect using the ingress role and transaction pooler>
# Run Alembic only with a separate operator/migration connection; never pass the ingress URL here.
# CONTINUUM_MIGRATION_DATABASE_URL=<separate TLS connection URL for the privileged migration role>
# Local destructive integration tests require a disposable loopback PostgreSQL 17 DB named continuum_t05_test.
# CONTINUUM_T05_TEST_DATABASE_URL=postgresql://postgres:<test-only-password>@127.0.0.1:5432/continuum_t05_test

# T06's private wake-receipt API is disabled unless both values are configured.
# This URL uses the separate continuum_wake_receiver login, never the Edge wake login.
# CONTINUUM_WAKE_RECEIVER_DATABASE_URL=postgresql://continuum_wake_receiver:...@<host>/<db>?sslmode=verify-full
# CONTINUUM_WAKE_BACKEND_TOKEN=<dedicated-high-entropy-edge-to-api-bearer-token>
# Do not put the one-use dispatch ticket, backend token, or database URL into pg_net headers.

# Checkpoint D process tests require their own disposable PostgreSQL 17 instance because
# the integration fixture creates and removes cluster-wide runtime roles.
# CONTINUUM_CHECKPOINT_D_TEST_DATABASE_URL=postgresql://postgres:<test-only-password>@127.0.0.1:55484/continuum_checkpoint_d_test
# Optional visual review retains only synthetic Checkpoint D rows in the disposable test DB.
# The runtime URL is written mode 0600 under this private /tmp directory and is never printed.
# CONTINUUM_CHECKPOINT_D_RETAIN_PATH=/tmp/continumm-checkpoint-d/visual

# T29 GitHub browser login is disabled until explicitly enabled and configured.
# Register this exact callback: https://<console-origin>/api/v1/auth/github/callback
CONTINUUM_ENABLE_GITHUB_AUTH=0
# Public run admission stays closed until deployment/workflow acceptance is verified.
CONTINUUM_ENABLE_PUBLIC_ADMISSION=0
# CONTINUUM_GITHUB_PUBLIC_ORIGIN=https://<console-origin>
# CONTINUUM_GITHUB_CLIENT_ID=<github-app-oauth-client-id>
# CONTINUUM_GITHUB_CLIENT_SECRET=<github-app-oauth-client-secret>
# CONTINUUM_GITHUB_APP_ID=<numeric-app-id-also-used-by-ingress>
# CONTINUUM_GITHUB_APP_PRIVATE_KEY=<server-only-PEM-key-from-secret-manager>
# CONTINUUM_GITHUB_STATE_KEY=<separate-random-state-key-at-least-32-bytes>
# Login also requires CONTINUUM_RUNTIME_DATABASE_URL and the existing encryption keyring.
# Review additionally requires the private CONTINUUM_SUPABASE_URL/SECRET_KEY/BUCKET above.
# Never place these secrets in VITE_* variables or browser storage.

# Explicit admitted workflow worker (--execute-workflow); this does not enable public admission.
# Reuse the server-only Vercel credentials above and configure the actual current
# accounting period and public/operator usage rows through the migration identity.
# CONTINUUM_SANDBOX_PROVIDER_PERIOD_ID=<existing-current-provider-period-id>
# Configure the image for the run's immutable admitted profile; never use a mutable tag.
# CONTINUUM_PYTHON_PROFILE_IMAGE=<registry/image>@sha256:<64-hex-digest>
# CONTINUUM_NODE_PROFILE_IMAGE=<registry/image>@sha256:<64-hex-digest>
# Model keys belong in Continuum's encrypted owner/run credential service, not env vars.

# Optional bounded wake worker; keep disabled until all runtime credentials and roles exist.
CONTINUUM_ENABLE_WAKE_WORKER=0
# Separate narrow function-only login; never reuse the receiver or runtime connection.
# CONTINUUM_WAKE_WORKER_DATABASE_URL=postgresql://continuum_wake_worker:<password>@<host>/<db>?sslmode=verify-full&sslrootcert=system
# Requires the workflow, App/OAuth, encryption, storage and immutable profile settings above.
# Starts at most one bounded task per process; PostgreSQL provides the cross-process fence.
