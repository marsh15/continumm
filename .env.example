CONTINUUM_ENVIRONMENT=development
CONTINUUM_HOST=127.0.0.1
CONTINUUM_PORT=8000
CONTINUUM_LOG_LEVEL=INFO
CONTINUUM_SUPABASE_BUCKET=continuum-t03-private
CONTINUUM_ENABLE_HOSTED_SMOKE=0
CONTINUUM_ENABLE_SANDBOX_SMOKE=0
CONTINUUM_SANDBOX_IMAGE=
CONTINUUM_T04_SMOKE_ID=

# Server-only values; do not commit populated credentials.
# CONTINUUM_DATABASE_URL=postgresql://...
# CONTINUUM_SUPABASE_URL=https://<project-ref>.supabase.co
# CONTINUUM_SUPABASE_SECRET_KEY=sb_secret_...
# CONTINUUM_SANDBOX_IMAGE=vercel/sandbox/python:3.14@sha256:<operator-supplied-digest>
# CONTINUUM_T04_SMOKE_ID=<fresh-canonical-uuid-used-once>
# CONTINUUM_VERCEL_TOKEN=...
# CONTINUUM_VERCEL_TEAM_ID=...
# CONTINUUM_VERCEL_PROJECT_ID=...

# T05 ingress is configured only in Supabase Function secrets; never expose these to the browser.
# CONTINUUM_GITHUB_APP_ID=<positive-decimal-github-app-id>
# CONTINUUM_GITHUB_WEBHOOK_SECRET=<high-entropy-github-app-webhook-secret>
# CONTINUUM_INGRESS_DATABASE_URL=<TLS URL copied from Supabase Connect using the ingress role and transaction pooler>
# Run Alembic only with a separate operator/migration connection; never pass the ingress URL here.
# CONTINUUM_MIGRATION_DATABASE_URL=<separate TLS connection URL for the privileged migration role>
# Local destructive integration tests require a disposable loopback PostgreSQL 17 DB named continuum_t05_test.
# CONTINUUM_T05_TEST_DATABASE_URL=postgresql://postgres:<test-only-password>@127.0.0.1:5432/continuum_t05_test
